{
  "permissions": {
    "allow": [
      "Bash(rm */PersonalProjects/Karmine/*)",
      "Bash(rm -r */PersonalProjects/Karmine/*)",
      "Bash(rm -rf */PersonalProjects/Karmine/*)",
      "Bash(mv */PersonalProjects/Karmine/* *)",
      "Bash(find */PersonalProjects/Karmine/* -delete)",
      "Bash(find */PersonalProjects/Karmine/* -exec rm *)",
      "Bash(*)",
      "WebSearch",
      "WebFetch(*)",
      "Skill(update-config)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(mv * /*)",
      "Bash(mv * ~/*)",
      "Bash(chmod -R * /*)",
      "Bash(chmod -R * ~/*)",
      "Bash(chown -R *)",
      "Bash(dd *)",
      "Bash(mkfs.*)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(init *)",
      "Bash(find * -delete)",
      "Bash(find * -exec rm *)",
      "Bash(shred *)",
      "Bash(truncate -s 0 *)",
      "> /dev/*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "/home/dindin23/PersonalProjects/Karmine/.claude/hooks/post-push-claude-md-check.sh",
            "statusMessage": "Checking CLAUDE.md against pushed changes..."
          }
        ]
      }
    ]
  }
}
